# Optional — form service endpoint for the contact form (e.g. https://formspree.io/f/xxxx).
# Leave empty and the form opens the visitor's email client instead.
# For the GitHub Pages build, add it as a repository variable named NEXT_PUBLIC_FORM_ENDPOINT.
NEXT_PUBLIC_FORM_ENDPOINT=

# Optional — WebSocket server URL for realtime features (live cursors, chat, presence)
# Leave empty to disable realtime features entirely
NEXT_PUBLIC_WS_URL=

# Optional — Google Analytics measurement ID
NEXT_PUBLIC_GA_ID=
